{
  "manifest_version": 3,
  "name": "REA Idm Mangaer Browser Bridge",
  "version": "0.1.0",
  "description": "Sends direct downloads to the local REA Idm Mangaer application.",
  "permissions": ["contextMenus", "nativeMessaging", "webRequest", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["config.js", "background.firefox.js"] },
  "action": { "default_title": "REA Idm Mangaer", "default_popup": "popup.html" },
  "browser_specific_settings": { "gecko": { "id": "rea-idm-mangaer@example.invalid", "strict_min_version": "121.0" } }
}
